{
  "name": "stock-sahamit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.stock.config.ts && node -e \"require('fs').cpSync('dist','dist-stock',{recursive:true})\"",
    "preview": "vite preview",
    "stock:dev": "vite --config vite.stock.config.ts",
    "stock:build": "vite build --config vite.stock.config.ts",
    "stock:preview": "vite preview --config vite.stock.config.ts",
    "build:fue-n": "vite build",
    "dev:full": "npm run build && wrangler pages dev",
    "db:migrate:local": "wrangler d1 migrations apply stock-sahamit-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply stock-sahamit-db --remote",
    "typecheck": "tsc --noEmit -p tsconfig.stock.json && tsc -p functions"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.152.0"
  }
}
